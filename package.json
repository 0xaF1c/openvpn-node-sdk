{
  "name": "openvpn-node-sdk-monorepo",
  "version": "0.1.0",
  "private": false,
  "description": "OpenVPN Node.js SDK: binary distribution, OpenVPN management interface client, and Windows tapctl adapter management",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "platform-packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none \"packages/**/src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "playground": "node playground/scripts/mock-flow.mjs",
    "playground:mock": "node playground/scripts/mock-flow.mjs",
    "playground:check": "node playground/scripts/check.mjs",
    "playground:config": "node playground/scripts/config.mjs",
    "playground:smoke": "node playground/scripts/smoke.mjs",
    "playground:connect": "node playground/scripts/connect.mjs",
    "playground:adapters": "node playground/scripts/adapters.mjs",
    "playground:offline": "node playground/scripts/check.mjs && node playground/scripts/config.mjs && node playground/scripts/mock-flow.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
