# dependencies / build output
node_modules/
.npm-cache/
dist/
# generated by scripts/build-single.mjs (bundled OpenVPN binaries)
packages/openvpn-sdk/vendor/
# copied into the package by scripts/prepare-release.mjs (npm only ships docs
# that live inside the package directory)
packages/openvpn-sdk/README.md
packages/openvpn-sdk/LICENSE
*.tsbuildinfo
coverage/
.reports/*
# reference OpenVPN source tree (kept local, has its own .git)
.reference/

# misc
*.log
.DS_Store
